# Copie para .env e preencha. NUNCA commite o .env.
# Este arquivo contém apenas NOMES de variáveis — nenhum valor real.

# ─── Telegram ────────────────────────────────────────────────────────────────
# Criado no @BotFather. Formato: 123456789:AA...
TELEGRAM_BOT_TOKEN=

# ─── Modelos (OpenRouter) ────────────────────────────────────────────────────
# Uma chave só, para os dois estágios. Criada em https://openrouter.ai/keys —
# e vale pôr um limite de crédito nela lá também, além do teto abaixo.
OPENROUTER_API_KEY=

# Sem mais nada, os dois estágios usam deepseek/deepseek-v4-flash. Para trocar
# o modelo de um estágio, qualquer ID do catálogo https://openrouter.ai/models:
#   LLM_EXTRACTION_MODEL=deepseek/deepseek-v4-flash
#   LLM_QA_MODEL=deepseek/deepseek-v4-flash
#
# Para falar com a Anthropic direto, sem a OpenRouter no meio:
#   LLM_EXTRACTION_PROVIDER=anthropic
#   LLM_EXTRACTION_MODEL=claude-sonnet-5
#   LLM_EXTRACTION_BASE_URL=https://api.anthropic.com
#   LLM_EXTRACTION_API_KEY=sk-ant-...

# Quanto de estrutura pedir ao provedor na extração:
#   schema — JSON Schema completo, decodificação restrita
#   json   — só garante JSON sintático
#   none   — nada; o schema vai no texto do prompt
# Em todos os casos quem garante o contrato é a validação posterior.
LLM_EXTRACTION_STRUCTURED=json
# Orçamento de saída. Modelo de raciocínio consome boa parte dele pensando.
LLM_EXTRACTION_MAX_TOKENS=64000
# Raciocínio do modelo: none | minimal | low | medium | high. Ver
# docs/evidence/2026-08-06-tempo-de-extracao.md antes de mexer.
LLM_EXTRACTION_REASONING=minimal
LLM_QA_REASONING=minimal

# ─── Teto de custo (slide 8) ─────────────────────────────────────────────────
# O gateway recusa a chamada quando o acumulado ultrapassa este valor.
BUDGET_USD_LIMIT=5

# ─── DataJud (API pública do CNJ) ────────────────────────────────────────────
# Chave PÚBLICA, publicada pelo CNJ. Não é segredo, mas fica fora do git
# porque o CNJ avisa que pode trocá-la a qualquer momento — buscar a atual em
# http://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ─── Serviços internos ───────────────────────────────────────────────────────
DOCLING_URL=http://docling:5001

POSTGRES_USER=leilao
POSTGRES_PASSWORD=
POSTGRES_DB=leilao

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Chave de 32+ caracteres usada para criptografar credenciais no banco do n8n.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Sao_Paulo

# ─── Túnel público (preenchido por ./scripts/tunnel-url.sh) ──────────────────
# URL HTTPS que o Telegram usa para entregar os webhooks.
WEBHOOK_URL=
